# Leave empty in development: the Vite dev server proxies /api to VITE_PROXY_TARGET.
# Set it for a production build served from a different origin, e.g. https://ledger-api.onrender.com (Vercel: Project Settings -> Environment Variables)
VITE_API_URL=

# Backend address the dev server proxies /api and /health to
VITE_PROXY_TARGET=http://localhost:3000

# ISO 4217 currency code used for display only
VITE_CURRENCY=INR
