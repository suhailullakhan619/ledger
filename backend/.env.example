# MongoDB connection string. Must be a replica set (every MongoDB Atlas cluster is one),
# because the API uses multi-document transactions.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name inside the cluster
MONGODB_DB_NAME=ledger

# Startup connection retries with exponential backoff (1s, 2s, 4s ... capped at 15s).
# Malformed connection strings and authentication failures are never retried.
MONGODB_CONNECT_RETRIES=5
MONGODB_RETRY_DELAY_MS=1000

# HTTP port for the API
PORT=3000

# Allowed browser origins (comma separated). "*" inside an entry is a wildcard,
# e.g. https://your-app.vercel.app,https://your-app-*.vercel.app. A bare * allows any origin.
CORS_ORIGIN=http://localhost:5173
