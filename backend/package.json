{
  "name": "transaction-ledger-api",
  "version": "1.0.0",
  "description": "Transaction Ledger API (Express + MongoDB) - accounts, credit/debit transactions, balances, history and transfers",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:memory": "node scripts/dev-memory.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "keywords": [
    "ledger",
    "api",
    "express",
    "mongodb"
  ],
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
